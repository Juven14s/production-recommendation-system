FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_REGISTRY_ROOT=/app/artifacts/model_registry

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir \
        "faiss-cpu>=1.9,<2.0" \
        "fastapi>=0.115,<1.0" \
        "lightgbm>=4.5,<5.0" \
        "numpy>=1.26,<3.0" \
        "pandas>=2.2,<3.0" \
        "prometheus-client>=0.21,<1.0" \
        "pyarrow>=18,<20" \
        "redis>=5.2,<8.0" \
        "uvicorn[standard]>=0.34,<1.0" \
    && python -m pip install --no-cache-dir --no-deps .

COPY release_bundle /app/artifacts/model_registry/bundles/champion
COPY release_registry.json /app/artifacts/model_registry/registry.json

EXPOSE 8000

CMD ["uvicorn", "mle_recsys.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
